<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Investment Plan - Daily Profit</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #0d0d0d;
            font-family: Arial, sans-serif;
            color: white;
            text-align: center;
        }
        header {
            background: #1a1a1a;
            padding: 20px;
            font-size: 28px;
            font-weight: bold;
            color: #00ff88;
        }
        .box {
            background: #111;
            width: 90%;
            max-width: 500px;
            margin: 30px auto;
            padding: 25px;
            border-radius: 10px;
            border: 1px solid #00ff88;
        }
        input, button {
            width: 90%;
            padding: 12px;
            margin-top: 10px;
            font-size: 16px;
            border-radius: 5px;
        }
        input {
            border: none;
        }
        button {
            background: #00ff88;
            border: none;
            font-weight: bold;
            cursor: pointer;
        }
        button:hover {
            background: #00cc6a;
        }
        footer {
            margin-top: 30px;
            font-size: 14px;
            color: #888;
        }
    </style>
</head>
<body>

<header>
    Investment Platform<br>
    Get Daily Profits
</header>

<div class="box">
    <h2>Calculate Your Daily Profit</h2>
    <input type="number" id="amount" placeholder="Enter Investment Amount">
    <button onclick="calcProfit()">Calculate Profit</button>
    <h3 id="result"></h3>
</div>

<div class="box">
    <h2>Contact For Registration</h2>
    <p>WhatsApp: <b>0300-1234567</b></p>
</div>

<footer>
    © 2025 Investment Platform - All rights reserved.
</footer>

<script>
    function calcProfit() {
        let amount = document.getElementById("amount").value;
        if (amount === "") {
            document.getElementById("result").innerHTML = "Please enter amount!";
            return;
        }

        let profit = amount * 0.03; // 3% Daily Profit
        document.getElementById("result").innerHTML = 
            "Daily Profit: PKR " + profit.toFixed(2);
    }
</script>

</body>
</html>
